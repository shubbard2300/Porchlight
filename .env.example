# Postgres connection string (Vercel Postgres, Neon, Supabase, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/porchlight"

# Random string, at least 32 characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# Comma-separated emails that become admins when they sign up
ADMIN_EMAILS="you@example.com"

# Where sign-up and submission notifications go until it is changed in Admin > Settings
ADMIN_NOTIFY_EMAIL="you@example.com"

# Email sending through Resend (https://resend.com). Without a key, emails are logged
# to the admin Form inbox but not delivered.
RESEND_API_KEY=""
EMAIL_FROM="Porchlight <onboarding@resend.dev>"
# Replies to Porchlight emails go here (e.g. an ImprovMX forwarding alias)
EMAIL_REPLY_TO=""

# Optional: Vercel Blob store for house photos (a read-write token, or BLOB_STORE_ID with Vercel OIDC).
# Without it, photos are kept in Postgres.
BLOB_READ_WRITE_TOKEN=""

# Public URL, used for links inside emails
APP_URL="http://localhost:3000"

# Used only by `npm run db:seed` to create the first admin account (sign in with `npm run sign-in-link -- <email>`)
SEED_ADMIN_EMAIL="admin@example.com"
# Optional: lets the seeded admin log in with a password right away
SEED_ADMIN_PASSWORD="change-me-please"

# Optional: Stripe, so hosts can pay their pot pledge by card (https://dashboard.stripe.com/apikeys).
# Start with test keys. Add a webhook at <APP_URL>/api/stripe/webhook for checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired and charge.refunded, and put
# its signing secret below. Without a key, pledges are recorded but the pay buttons stay hidden.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: push alerts. Generate a key pair once with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@porchlightcontest.com"
# Vercel sends this with its cron calls (the "last call to vote" alert). Any long random string.
CRON_SECRET=""
