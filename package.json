{
  "name": "porchlight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "sign-in-link": "tsx scripts/sign-in-link.ts",
    "email-preview": "tsx scripts/email-preview.ts",
    "vercel-build": "prisma generate && bash scripts/migrate-deploy.sh && next build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "jose": "5.10.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "^3.6.4",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
