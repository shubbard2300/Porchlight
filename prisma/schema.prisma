generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum HouseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  VIEWER
  HOST
}

/// How a visitor proved they were at a house: standing inside its geofence, or scanning the porch QR sign.
enum CheckInMethod {
  GEO
  QR
}

enum TokenPurpose {
  VERIFY
  LOGIN
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  username        String      @unique
  accountType     AccountType @default(VIEWER)
  emailVerifiedAt DateTime?
  /// bcrypt hash. Null for accounts created before passwords existed; they can set one on their profile.
  passwordHash    String?
  role            Role        @default(USER)
  xp              Int         @default(0)
  referralCode    String      @unique
  referredById    String?
  referredBy      User?       @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]      @relation("Referrals")
  marketingOptIn  Boolean     @default(false)

  // Profile (all optional)
  displayName     String?
  bio             String?
  hometown        String?
  avatarUpdatedAt DateTime?
  avatar          Avatar?

  // Host profile (optional, filled in after verifying)
  propertyAddress String?
  neighborhood    String?
  hostSeason      String?
  decorationTheme String?
  propertyDetails String?

  createdAt   DateTime     @default(now())
  lastLoginAt DateTime?
  houses      House[]
  housePhotos HousePhoto[]
  votes       Vote[]
  checkIns    CheckIn[]
  tokens      EmailToken[]
}

/// Profile photo, resized in the browser before upload. Kept out of User so user queries stay small.
model Avatar {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
}

/// One-time links for verifying an email and for signing in. Only a SHA-256 hash of the token is stored.
model EmailToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  next      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
}

model House {
  id                String       @id @default(cuid())
  ownerId           String
  owner             User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  season            String
  name              String
  address           String
  neighborhood      String?
  lat               Float?
  lng               Float?
  showExactAddress  Boolean      @default(true)
  tags              String[]
  /// Category bracket key from src/lib/brackets.ts. Null for entries made before brackets existed.
  bracket           String?
  litFrom           String
  litUntil          String
  description       String
  /// Public URLs of the house photos in display order. Kept in sync with `photos` so cards need no join.
  photoUrls         String[]
  photos            HousePhoto[]
  contributionCents Int          @default(0)
  status            HouseStatus  @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  votes             Vote[]
  checkIns          CheckIn[]

  @@index([season, status])
  @@index([season, bracket])
}

/// A photo a host took or chose of their display. Uploaded before the entry exists (houseId null)
/// when it comes from the submit form, then attached when the entry is created.
model HousePhoto {
  id             String          @id @default(cuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  houseId        String?
  house          House?          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  /// Where the site shows the photo: the public Vercel Blob URL, or /house-photo/<id> when stored in Postgres.
  url            String
  /// The Vercel Blob file, when Blob is set up. Used to delete it.
  blobUrl        String?
  width          Int
  height         Int
  /// Where the photo was taken. Never shown publicly; the house's own lat/lng is what the map uses.
  lat            Float?
  lng            Float?
  /// "photo" when read from the photo's GPS tags, "device" when the browser shared its location.
  locationSource String?
  takenAt        DateTime?
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  file           HousePhotoFile?

  @@index([houseId])
  @@index([ownerId])
}

/// Image bytes for house photos when Vercel Blob isn't set up. Kept out of HousePhoto so photo queries stay small.
model HousePhotoFile {
  photoId     String     @id
  photo       HousePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
}

/// A visitor proving they stood at a house. Unlocks voting there; later feeds the crowd meter and host stats.
/// The visitor's own coordinates are never stored, only how far from the house they were.
model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String
  house     House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  method    CheckInMethod
  distanceM Int?
  createdAt DateTime      @default(now())

  @@index([houseId, createdAt])
  @@index([userId, houseId])
}

/// One rating per person per house. A like only counts toward the pot once verifiedAt is set.
/// The four scores (1 to 10) are the visitor's scorecard; null on votes cast before scorecards existed.
model Vote {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId      String
  house        House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  liked        Boolean
  verifiedAt   DateTime?
  verifyLat    Float?
  verifyLng    Float?
  photoUrl     String?
  comment      String?
  creativity   Int?
  lighting     Int?
  storytelling Int?
  sound        Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([userId, houseId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Every email the app sends, delivered or not. Shown in the admin Form inbox.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  kind      String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
