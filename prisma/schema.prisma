generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ADMIN is a Super Admin. EDITOR reviews and edits anyone's content. See src/lib/roles.ts.
enum Role {
  USER
  EDITOR
  ADMIN
}

enum HouseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  VIEWER
  HOST
}

/// How a visitor proved they were at a house: standing inside its geofence, or scanning the porch QR sign.
enum CheckInMethod {
  GEO
  QR
}

/// Sponsorship level for a merchant pitstop. Higher tiers get bigger pins and show up nearer the top.
enum PitstopTier {
  BRONZE
  SILVER
  GOLD
}

enum TokenPurpose {
  VERIFY
  LOGIN
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  username        String      @unique
  accountType     AccountType @default(VIEWER)
  emailVerifiedAt DateTime?
  /// bcrypt hash. Null for accounts created before passwords existed; they can set one on their profile.
  passwordHash    String?
  role            Role        @default(USER)
  xp              Int         @default(0)
  referralCode    String      @unique
  referredById    String?
  referredBy      User?       @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]      @relation("Referrals")
  marketingOptIn  Boolean     @default(false)
  /// When they agreed to the Terms and Official Rules at sign-up (by pressing "Create my account").
  termsAcceptedAt DateTime?
  /// Welcome tours finished or skipped: "viewer", "host". Each one pays TOUR_XP once, when finished.
  toursDone       String[]    @default([])

  // Profile (all optional)
  displayName     String?
  bio             String?
  hometown        String?
  avatarUpdatedAt DateTime?
  avatar          Avatar?

  // Host profile (optional, filled in after verifying)
  propertyAddress String?
  neighborhood    String?
  hostSeason      String?
  decorationTheme String?
  propertyDetails String?

  createdAt      DateTime           @default(now())
  lastLoginAt    DateTime?
  houses         House[]
  housePhotos    HousePhoto[]
  votes          Vote[]
  checkIns       CheckIn[]
  tokens         EmailToken[]
  pitstopScans   PitstopScan[]
  /// Scanning a merchant's counter QR doubles XP until this time. Contest votes are never boosted.
  xpBoostUntil   DateTime?
  ledCaravans    Caravan[]          @relation("CaravanLeader")
  caravanMembers CaravanMember[]
  potPayments    PotPayment[]
  pushSubs       PushSubscription[]
  arCatches      ArCatch[]

  // Push alerts. The spot is only used to decide which new houses are "near you"; it is never shown.
  alertNearby   Boolean @default(true)
  alertHost     Boolean @default(true)
  alertSquad    Boolean @default(true)
  alertLastCall Boolean @default(true)
  alertLat      Float?
  alertLng      Float?
  alertRadiusKm Int     @default(3)
}

/// Profile photo, resized in the browser before upload. Kept out of User so user queries stay small.
model Avatar {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
}

/// One-time links for verifying an email and for signing in. Only a SHA-256 hash of the token is stored.
model EmailToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  next      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
}

model House {
  id                String        @id @default(cuid())
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  season            String
  name              String
  address           String
  neighborhood      String?
  lat               Float?
  lng               Float?
  showExactAddress  Boolean       @default(true)
  tags              String[]
  /// Category bracket key from src/lib/brackets.ts. Null for entries made before brackets existed.
  bracket           String?
  litFrom           String
  litUntil          String
  description       String
  /// Public URLs of the house photos in display order. Kept in sync with `photos` so cards need no join.
  photoUrls         String[]
  photos            HousePhoto[]
  contributionCents Int           @default(0)
  /// When the host ticked the official rules agreement on the submit form, and which version of the rules it was.
  rulesAcceptedAt   DateTime?
  rulesVersion      String?
  status            HouseStatus   @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  votes             Vote[]
  checkIns          CheckIn[]
  potPayments       PotPayment[]
  arCatches         ArCatch[]
  arDecorations     ArDecoration[]
  /// Short line the host floats over the house in the AR view, e.g. "Happy haunting!".
  arGreeting        String?
  porchTrigger      PorchTrigger?
  /// When the host was last pinged about a like, so a busy night sends one alert per half hour, not one per vote.
  lastLikeAlertAt   DateTime?

  @@index([season, status])
  @@index([season, bracket])
}

/// A photo a host took or chose of their display. Uploaded before the entry exists (houseId null)
/// when it comes from the submit form, then attached when the entry is created.
model HousePhoto {
  id             String          @id @default(cuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  houseId        String?
  house          House?          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  /// Where the site shows the photo: the public Vercel Blob URL, or /house-photo/<id> when stored in Postgres.
  url            String
  /// The Vercel Blob file, when Blob is set up. Used to delete it.
  blobUrl        String?
  width          Int
  height         Int
  /// Where the photo was taken. Never shown publicly; the house's own lat/lng is what the map uses.
  lat            Float?
  lng            Float?
  /// "photo" when read from the photo's GPS tags, "device" when the browser shared its location.
  locationSource String?
  takenAt        DateTime?
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  file           HousePhotoFile?

  @@index([houseId])
  @@index([ownerId])
}

/// Image bytes for house photos when Vercel Blob isn't set up. Kept out of HousePhoto so photo queries stay small.
model HousePhotoFile {
  photoId     String     @id
  photo       HousePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
}

/// A visitor proving they stood at a house. Unlocks voting there; later feeds the crowd meter and host stats.
/// The visitor's own coordinates are never stored, only how far from the house they were.
model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String
  house     House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  method    CheckInMethod
  distanceM Int?
  /// The caravan the visitor was rolling with, if any.
  caravanId String?
  caravan   Caravan?      @relation(fields: [caravanId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([houseId, createdAt])
  @@index([caravanId, houseId])
  @@index([userId, houseId])
}

/// One rating per person per house. A like only counts toward the pot once verifiedAt is set.
/// The four scores (1 to 10) are the visitor's scorecard; null on votes cast before scorecards existed.
model Vote {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId      String
  house        House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  liked        Boolean
  verifiedAt   DateTime?
  verifyLat    Float?
  verifyLng    Float?
  photoUrl     String?
  comment      String?
  creativity   Int?
  lighting     Int?
  storytelling Int?
  sound        Int?
  /// Set when the voter scored the house while in a caravan; feeds the house's Squad Reviews.
  caravanId    String?
  caravan      Caravan?  @relation(fields: [caravanId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([userId, houseId])
  @@index([caravanId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Every email the app sends, delivered or not. Shown in the admin Form inbox.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  kind      String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A local business sponsoring the contest. Admins add these until sponsorships can be bought online.
model Merchant {
  id          String        @id @default(cuid())
  name        String
  category    String
  tier        PitstopTier   @default(SILVER)
  address     String
  lat         Float?
  lng         Float?
  /// The deal shown on the map, e.g. "20% off hot cocoa after 5 pm".
  offer       String
  hours       String?
  website     String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  scans       PitstopScan[]
  potPayments PotPayment[]
}

/// A visitor scanning a merchant's counter QR. Starts an XP boost; also tells the merchant how much foot traffic the contest sent.
model PitstopScan {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([userId, createdAt])
}

/// A well-known decorated street or neighborhood the contest is seeded around. Shown as a glowing zone
/// on the map with its own page, so new visitors know where to start and neighbors know to join in.
model AnchorBlock {
  id        String   @id @default(cuid())
  name      String
  /// One or two sentences on what makes the block worth the trip.
  blurb     String
  /// Where the zone is centered; geocoded unless coordinates are given.
  address   String
  lat       Float?
  lng       Float?
  radiusM   Int      @default(400)
  /// Featured blocks are listed on the home page.
  featured  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A group touring together for a night. Members join with a code; their check-ins and scorecards
/// roll up into a Squad Review on each house. Votes still count one per person.
model Caravan {
  id        String          @id @default(cuid())
  name      String
  /// Short code for the invite link and QR.
  code      String          @unique
  leaderId  String
  leader    User            @relation("CaravanLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  endsAt    DateTime
  members   CaravanMember[]
  checkIns  CheckIn[]
  votes     Vote[]

  @@index([leaderId])
}

model CaravanMember {
  id        String    @id @default(cuid())
  caravanId String
  caravan   Caravan   @relation(fields: [caravanId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@unique([caravanId, userId])
  @@index([userId])
}

enum PotSource {
  HOST
  SPONSOR
}

enum PotPaymentStatus {
  PENDING
  PAID
  REFUNDED
  EXPIRED
}

/// Money in a season's prize pot. Hosts pay their optional pledge through Stripe Checkout once their
/// house is approved; sponsors' additions are recorded by an admin. Only PAID rows count toward the pot.
model PotPayment {
  id                    String           @id @default(cuid())
  season                String
  source                PotSource        @default(HOST)
  amountCents           Int
  status                PotPaymentStatus @default(PENDING)
  houseId               String?
  house                 House?           @relation(fields: [houseId], references: [id], onDelete: SetNull)
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// For sponsor additions: the pitstop that put in the money, or just a name.
  merchantId            String?
  merchant              Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  sponsorName           String?
  stripeSessionId       String?          @unique
  stripePaymentIntentId String?          @unique
  /// When the payer ticked the official rules agreement before checkout, and which version of the rules it was.
  rulesAcceptedAt       DateTime?
  rulesVersion          String?
  createdAt             DateTime         @default(now())
  paidAt                DateTime?
  refundedAt            DateTime?

  @@index([season, status])
  @@index([houseId])
}

/// A browser or installed app that agreed to receive push alerts for a user.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// A visitor catching the AR critter hiding at a house they checked in at. One per house per person.
model ArCatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  season    String
  /// Critter key from src/lib/hunt.ts.
  critter   String
  createdAt DateTime @default(now())

  @@unique([userId, houseId])
  @@index([userId, season])
}

/// A virtual prop a host placed on their house for visitors to see through the camera.
/// x and y are fractions of a 3:4 portrait frame over the house photo (see src/lib/arDecor.ts).
model ArDecoration {
  id        String   @id @default(cuid())
  houseId   String
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  /// Prop key from src/lib/arDecor.ts.
  kind      String
  x         Float
  y         Float
  scale     Float    @default(1)
  /// Back-to-front drawing order.
  position  Int
  createdAt DateTime @default(now())

  @@index([houseId, position])
}

/// A host's smart-light hook: Porchlight POSTs to this URL (IFTTT, Home Assistant, Zapier...) when
/// visitors check in, like the house or catch its critter, so the lights can flash a greeting.
model PorchTrigger {
  id          String    @id @default(cuid())
  houseId     String    @unique
  house       House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  url         String
  /// Signs each call (X-Porchlight-Signature) so a receiver can check it came from us.
  secret      String
  onCheckIn   Boolean   @default(true)
  onLike      Boolean   @default(true)
  onCatch     Boolean   @default(true)
  enabled     Boolean   @default(true)
  lastFiredAt DateTime?
  lastStatus  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
